{
  "expo": {
    "name": "adaption",
    "slug": "adaption",
    "description": "Школьный дневник НИШ: оценки, журнал, табель, расписание и калькулятор СОР/СОЧ",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "adaption",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3f5f6"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "buildNumber": "2",
      "supportsTablet": true,
      "bundleIdentifier": "top.adaption.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Для быстрой и безопасной разблокировки приложения с помощью Face ID"
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "top.adaption.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "telegram": "https://t.me/academia_nis",
      "website": "https://adaption.top"
    }
  }
}
