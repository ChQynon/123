{
  "name": "adaption-desktop",
  "version": "1.0.1",
  "description": "Школьный дневник НИШ для ПК и Mac: оценки, журнал, табель, расписание и калькулятор СОР/СОЧ",
  "author": "adaption (Telegram: @academia_nis)",
  "homepage": "https://adaption.top",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChQynon/123"
  },
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "top.adaption.app",
    "productName": "adaption",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "identity": null,
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "adaption"
    }
  },
  "dependencies": {
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
